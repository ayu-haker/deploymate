{
  "expo": {
    "name": "DeployMate",
    "slug": "deploymate",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "deploymate",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.deploymate.app"
    },
    "android": {
      "package": "io.deploymate.app"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
