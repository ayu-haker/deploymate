# Database & Redis
DATABASE_URL="postgresql://deploymate:deploymate_secret@localhost:5432/deploymate?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth Secrets
JWT_SECRET="deploymate_super_secret_jwt_access_key_change_in_prod"
JWT_REFRESH_SECRET="deploymate_super_secret_jwt_refresh_key_change_in_prod"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# API Gateway Configuration
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="*"

# GitHub Integration
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/v1/auth/github/callback"

# Deployment Providers (API Keys / Service Credentials)
VERCEL_TOKEN="your_vercel_bearer_token"
NETLIFY_TOKEN="your_netlify_personal_access_token"
KUBERNETES_CONFIG="" # Base64 or local kubeconfig path

# Self-Hosted AI Engine (Ollama / vLLM)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3" # or codellama, mistral, qwen

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
